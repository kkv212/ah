local time = 0

RunService.RenderStepped:Connect(function(dt)
    if not rowConfig.enabled then
        return
    end
    
    local character = getTargetCharacter()
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not torso or not humanoidRootPart then
        return
    end
    
    time += dt * rowConfig.waveSpeed
    
    local charCFrame = humanoidRootPart.CFrame
    local rightVector = charCFrame.RightVector
    local lookVector = charCFrame.LookVector
    
    local basePosition = torso.Position + 
                         Vector3.new(0, rowConfig.heightOffset, 0) + 
                         (lookVector * rowConfig.forwardOffset) +
                         (rightVector * rowConfig.sidewaysOffset)
    
    for i, point in ipairs(rowPoints) do
        if point.assignedObject and point.assignedObject.BP and point.assignedObject.BG then
            local obj = point.assignedObject
            
            if rowConfig.animationMode == "tree" then
                -- ツリーモード：螺旋状に回転
                local radius = math.abs(obj.baseOffsetX)
                local heightIndex = obj.index
                local angle = time * rowConfig.treeRotationSpeed + (heightIndex * 0.5)
                
                -- 基本的な螺旋の位置
                local x = math.cos(angle) * radius
                local z = math.sin(angle) * radius
                local y = heightIndex * rowConfig.treeHeightSpacing
                
                -- ツリーの軸を傾ける（回転行列を適用）
                local tiltRadX = math.rad(rowConfig.treeTiltX)
                local tiltRadZ = math.rad(rowConfig.treeTiltZ)
                
                -- Z軸回転（左右の傾き）
                local x1 = x * math.cos(tiltRadZ) - y * math.sin(tiltRadZ)
                local y1 = x * math.sin(tiltRadZ) + y * math.cos(tiltRadZ)
                local z1 = z
                
                -- X軸回転（前後の傾き）
                local x2 = x1
                local y2 = y1 * math.cos(tiltRadX) - z1 * math.sin(tiltRadX)
                local z2 = y1 * math.sin(tiltRadX) + z1 * math.cos(tiltRadX)
                
                local finalPosition = basePosition + Vector3.new(x2, y2, z2)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                -- プレイヤーを向く設定
                if rowConfig.lookAtPlayer then
                    baseCFrame = CFrame.lookAt(finalPosition, humanoidRootPart.Position)
                end
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "radial" then
                -- 放射状モード：中心から放射状に広がり回転
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 全体の回転
                local globalRotation = time * rowConfig.radialRotationSpeed
                
                -- 放射状の角度を計算
                local angleRange = math.rad(rowConfig.radialAngleSpread)
                local baseAngle = (index / totalObjects) * angleRange - (angleRange / 2)
                local angle = baseAngle + globalRotation
                
                -- 距離をランダム化（より自然な広がり）
                local seed = index * 12345
                local function seededRandom(s)
                    s = (s * 9301 + 49297) % 233280
                    return s / 233280, s
                end
                local rand = seededRandom(seed)
                
                -- 中心からの距離（近いものから遠いものまで）
                local distance = rowConfig.radialLength * (0.3 + rand * 0.7)
                
                local x = math.cos(angle) * distance
                local z = math.sin(angle) * distance
                local y = 0
                
                local finalPosition = basePosition + Vector3.new(x, y, z)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                -- 放射方向を向く
                local lookAngle = angle
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, lookAngle + playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                -- プレイヤーを向く設定
                if rowConfig.lookAtPlayer then
                    baseCFrame = CFrame.lookAt(finalPosition, humanoidRootPart.Position)
                end
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "icosahedron" then
                -- 正二十面体モード：12個の頂点と20個の面を持つ立体
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 黄金比
                local phi = (1 + math.sqrt(5)) / 2
                
                -- 正二十面体の12個の頂点座標
                local vertices = {
                    {0, 1, phi}, {0, -1, phi}, {0, 1, -phi}, {0, -1, -phi},
                    {1, phi, 0}, {-1, phi, 0}, {1, -phi, 0}, {-1, -phi, 0},
                    {phi, 0, 1}, {-phi, 0, 1}, {phi, 0, -1}, {-phi, 0, -1}
                }
                
                -- 頂点を正規化
                local function normalize(v)
                    local len = math.sqrt(v[1]*v[1] + v[2]*v[2] + v[3]*v[3])
                    return {v[1]/len, v[2]/len, v[3]/len}
                end
                
                for i = 1, #vertices do
                    vertices[i] = normalize(vertices[i])
                end
                
                -- 全体の回転
                local rotation = time * rowConfig.icosahedronRotationSpeed
                
                -- 頂点、辺、面の中心に配置
                local vertexCount = 12
                local edgeCount = 30
                local objectsPerVertex = math.ceil(totalObjects / vertexCount)
                
                local vertexIndex = math.floor(index / objectsPerVertex) % vertexCount + 1
                local offset = (index % objectsPerVertex) / objectsPerVertex
                
                -- 選択された頂点
                local v = vertices[vertexIndex]
                
                -- サイズと回転を適用
                local rotY = rotation
                local rotX = rotation * 0.7
                
                local x = v[1]
                local y = v[2]
                local z = v[3]
                
                -- Y軸回転
                local x1 = x * math.cos(rotY) - z * math.sin(rotY)
                local z1 = x * math.sin(rotY) + z * math.cos(rotY)
                
                -- X軸回転
                local y1 = y * math.cos(rotX) - z1 * math.sin(rotX)
                local z2 = y * math.sin(rotX) + z1 * math.cos(rotX)
                
                -- スケール適用
                x1 = x1 * rowConfig.icosahedronSize * (0.8 + offset * 0.4)
                y1 = y1 * rowConfig.icosahedronSize * (0.8 + offset * 0.4)
                z2 = z2 * rowConfig.icosahedronSize * (0.8 + offset * 0.4)
                
                local finalPosition = basePosition + Vector3.new(x1, y1, z2)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                -- プレイヤーを向く設定
                if rowConfig.lookAtPlayer then
                    baseCFrame = CFrame.lookAt(finalPosition, humanoidRootPart.Position)
                end
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "destroyer" then
                -- デストロイヤーモード：破壊兵器のような配置
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 3つのセクション：中央コア、回転砲台、外部防衛システム
                local section = math.floor(index / (totalObjects / 3))
                local posInSection = (index % (totalObjects / 3)) / (totalObjects / 3)
                
                local x, y, z
                
                if section == 0 then
                    -- 中央コア：縦に並ぶ主砲
                    local coreHeight = posInSection * rowConfig.destroyerRadius * 2
                    local coreRotation = time * rowConfig.destroyerSpeed
                    local coreRadius = rowConfig.destroyerRadius * 0.3
                    
                    x = math.cos(coreRotation + posInSection * math.pi * 2) * coreRadius
                    z = math.sin(coreRotation + posInSection * math.pi * 2) * coreRadius
                    y = coreHeight - rowConfig.destroyerRadius
                    
                elseif section == 1 then
                    -- 回転砲台：円形に配置された砲塔
                    local turretAngle = posInSection * 2 * math.pi + time * rowConfig.destroyerSpeed * 2
                    local turretRadius = rowConfig.destroyerRadius * 0.6
                    local turretLayer = math.floor(posInSection * 4)
                    local layerHeight = turretLayer * rowConfig.destroyerRadius * 0.4
                    
                    -- 砲塔が外を向くように前に突き出す
                    local extendDistance = rowConfig.destroyerRadius * 0.3 * math.sin(time * rowConfig.destroyerSpeed * 3 + posInSection * 10)
                    
                    x = math.cos(turretAngle) * (turretRadius + extendDistance)
                    z = math.sin(turretAngle) * (turretRadius + extendDistance)
                    y = layerHeight - rowConfig.destroyerRadius * 0.5
                    
                else
                    -- 外部防衛システム：外周を高速回転する防衛網
                    local defenseAngle = posInSection * 2 * math.pi - time * rowConfig.destroyerSpeed * 4
                    local defenseRadius = rowConfig.destroyerRadius * (0.8 + math.sin(time * 2 + posInSection * 5) * 0.2)
                    
                    -- 防衛システムは上下に波打つ
                    local waveHeight = math.sin(posInSection * math.pi * 6 + time * rowConfig.destroyerSpeed * 2) * rowConfig.destroyerRadius * 0.3
                    
                    x = math.cos(defenseAngle) * defenseRadius
                    z = math.sin(defenseAngle) * defenseRadius
                    y = waveHeight
                end
                
                -- カオス効果でブレを追加
                local chaos = rowConfig.destroyerChaos * 0.1
                x = x + math.sin(time * 7 + index) * chaos
                y = y + math.cos(time * 5 + index) * chaos
                z = z + math.sin(time * 6 + index) * chaos
                
                local finalPosition = basePosition + Vector3.new(x, y, z)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                -- 砲塔のように外側を向く
                local lookAngle = math.atan2(z, x)
                local tiltAngle = math.atan2(math.sqrt(x*x + z*z), y)
                
                local baseCFrame = CFrame.new(finalPosition)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), lookAngle + math.rad(rowConfig.yRotation), math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "grid" then
                -- グリッドモード：均一で綺麗な配置
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- グリッドのサイズを計算（正方形に近い形）
                local gridWidth = math.ceil(math.sqrt(totalObjects))
                local gridHeight = math.ceil(totalObjects / gridWidth)
                
                local row = math.floor(index / gridWidth)
                local col = index % gridWidth
                
                -- 中心を原点にする
                local offsetX = (col - (gridWidth - 1) / 2) * rowConfig.gridSpacing
                local offsetZ = (row - (gridHeight - 1) / 2) * rowConfig.gridSpacing
                
                -- グリッド全体の回転を適用
                local rotRad = math.rad(rowConfig.gridRotation + time * 10)
                local x = offsetX * math.cos(rotRad) - offsetZ * math.sin(rotRad)
                local z = offsetX * math.sin(rotRad) + offsetZ * math.cos(rotRad)
                
                -- 高さは波のように
                local waveHeight = math.sin(row * 0.5 + col * 0.5 + time) * rowConfig.gridSize * 0.3
                local y = waveHeight
                
                local finalPosition = basePosition + Vector3.new(x, y, z)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "magic3d" then
                -- 3D魔法陣モード：複数の円が回転する立体的な魔法陣
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 複雑さに応じてリングを増やす
                local totalRings = rowConfig.magic3dLayers * rowConfig.magic3dComplexity
                local objectsPerRing = math.ceil(totalObjects / totalRings)
                local ringIndex = math.floor(index / objectsPerRing)
                local positionInRing = index % objectsPerRing
                
                -- リングの種類（水平、垂直、斜め）
                local ringType = ringIndex % 3
                local layerIndex = math.floor(ringIndex / 3)
                
                -- パルス効果
                local pulse = 1 + math.sin(time * 3 + ringIndex) * rowConfig.magic3dPulse * 0.2
                
                -- 各リングの回転速度（異なる速度）
                local rotationSpeed = rowConfig.magic3dRotationSpeed * (1 + ringIndex * 0.2)
                if ringIndex % 2 == 1 then
                    rotationSpeed = -rotationSpeed
                end
                local rotation = time * rotationSpeed
                
                local angle = (positionInRing / objectsPerRing) * 2 * math.pi + rotation
                local radius = rowConfig.magic3dRadius * pulse
                
                local x, y, z
                
                if ringType == 0 then
                    -- 水平リング
                    local height = (layerIndex - (rowConfig.magic3dLayers - 1) / 2) * (rowConfig.magic3dRadius * 0.6)
                    x = math.cos(angle) * radius * (0.6 + 0.4 * layerIndex / rowConfig.magic3dLayers)
                    z = math.sin(angle) * radius * (0.6 + 0.4 * layerIndex / rowConfig.magic3dLayers)
                    y = height
                elseif ringType == 1 then
                    -- 垂直リング（縦方向）
                    x = math.cos(angle) * radius * 0.7
                    y = math.sin(angle) * radius * 0.7
                    z = layerIndex * (rowConfig.magic3dRadius * 0.3)
                else
                    -- 斜めリング
                    local tilt = math.pi / 4 + (layerIndex * math.pi / 8)
                    x = math.cos(angle) * radius * 0.8
                    y = math.sin(angle) * math.cos(tilt) * radius * 0.8
                    z = math.sin(angle) * math.sin(tilt) * radius * 0.8
                end
                
                local finalPosition = basePosition + Vector3.new(x, y, z)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                -- 中心を向くように回転 + 自転
                local lookAtCenter = CFrame.lookAt(finalPosition, basePosition)
                local spinRotation = time * 5 * rotationSpeed
                local baseCFrame = lookAtCenter * CFrame.Angles(math.rad(rowConfig.xRotation), math.rad(rowConfig.yRotation + spinRotation), math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "explosion" then
                -- 爆発モード：ランダムな方向に飛び散る
                local index = obj.index - 1
                
                -- 各オブジェクトに固有のランダム方向を生成（シード値を使用）
                local seed = index * 12345
                local function seededRandom(s)
                    s = (s * 9301 + 49297) % 233280
                    return s / 233280, s
                end
                
                local rand1, newSeed = seededRandom(seed)
                local rand2, newSeed2 = seededRandom(newSeed)
                local rand3 = seededRandom(newSeed2)
                
                -- ランダムな方向ベクトル
                local theta = rand1 * 2 * math.pi
                local phi = rand2 * math.pi
                local chaos = rand3 * rowConfig.explosionChaos
                
                -- 時間による距離の変化（パルス効果）
                local pulseDistance = math.abs(math.sin(time * rowConfig.explosionSpeed)) * rowConfig.explosionRadius
                
                -- ランダムな方向に飛ぶ
                local x = math.sin(phi) * math.cos(theta) * (pulseDistance + chaos)
                local y = math.cos(phi) * (pulseDistance + chaos)
                local z = math.sin(phi) * math.sin(theta) * (pulseDistance + chaos)
                
                local finalPosition = basePosition + Vector3.new(x, y, z)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                -- ランダムな回転も追加
                local rotX = rand1 * 360
                local rotY = rand2 * 360
                local rotZ = rand3 * 360
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation + rotY * time), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation + rotX * time), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation + rotZ * time))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "manji" then
                -- 卍モード：卍の形に配置
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 全体の回転
                local globalRotation = time * rowConfig.manjiRotationSpeed
                
                -- 卍は4つの腕から構成され、各腕は2つのセグメント（直線部分と曲がり部分）
                local objectsPerArm = totalObjects / 4
                local armIndex = math.floor(index / objectsPerArm)
                local positionInArm = (index % objectsPerArm) / objectsPerArm
                
                -- 各腕の角度
                local armAngle = (armIndex * math.pi / 2) + globalRotation
                
                local x, z
                local armLength = rowConfig.manjiSize * 0.6
                local hookLength = rowConfig.manjiSize * 0.4
                
                if positionInArm < 0.6 then
                    -- メインの直線部分（中心から外へ）
                    local dist = (positionInArm / 0.6) * armLength
                    x = math.cos(armAngle) * dist
                    z = math.sin(armAngle) * dist
                else
                    -- 先端の曲がり部分（時計回りに90度）
                    local hookProgress = (positionInArm - 0.6) / 0.4
                    local hookDist = hookProgress * hookLength
                    
                    -- 時計回りに曲がる = 角度を -90度
                    local hookAngle = armAngle - math.pi / 2
                    
                    x = math.cos(armAngle) * armLength + math.cos(hookAngle) * hookDist
                    z = math.sin(armAngle) * armLength + math.sin(hookAngle) * hookDist
                end
                
                local y = 0
                
                -- 卍の傾きを適用
                local tiltRad = math.rad(rowConfig.manjiTilt)
                local x_tilted = x
                local y_tilted = y * math.cos(tiltRad) - z * math.sin(tiltRad)
                local z_tilted = y * math.sin(tiltRad) + z * math.cos(tiltRad)
                
                local finalPosition = basePosition + Vector3.new(x_tilted, y_tilted, z_tilted)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "hexagram" then
                -- 六芒星モード：2つの三角形を重ねた星型
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 全体の回転
                local globalRotation = time * rowConfig.hexagramRotationSpeed
                
                -- 六芒星は2つの正三角形（上向きと下向き）で構成
                -- 6つの頂点 + 12の交点を作る
                local halfObjects = math.floor(totalObjects / 2)
                local isFirstTriangle = index < halfObjects
                
                local triangleIndex = isFirstTriangle and index or (index - halfObjects)
                local triangleObjects = isFirstTriangle and halfObjects or (totalObjects - halfObjects)
                
                -- 三角形の辺を描く（3辺×各辺に沿って配置）
                local objectsPerEdge = triangleObjects / 3
                local edgeIndex = math.floor(triangleIndex / objectsPerEdge) % 3
                local t = (triangleIndex % objectsPerEdge) / objectsPerEdge
                
                -- 三角形の頂点の位置
                local rotation = isFirstTriangle and 0 or math.pi -- 下向き三角形は180度回転
                local vertices = {}
                for i = 0, 2 do
                    local angle = (i * 2 * math.pi / 3) + rotation - (math.pi / 2) + globalRotation
                    vertices[i] = {
                        x = math.cos(angle) * rowConfig.hexagramRadius,
                        z = math.sin(angle) * rowConfig.hexagramRadius
                    }
                end
                
                -- 開始点と終了点
                local startVertex = vertices[edgeIndex]
                local endVertex = vertices[(edgeIndex + 1) % 3]
                
                -- 線形補間
                local x = startVertex.x + (endVertex.x - startVertex.x) * t
                local z = startVertex.z + (endVertex.z - startVertex.z) * t
                local y = 0
                
                -- 六芒星の傾きを適用
                local tiltRad = math.rad(rowConfig.hexagramTilt)
                local x_tilted = x
                local y_tilted = y * math.cos(tiltRad) - z * math.sin(tiltRad)
                local z_tilted = y * math.sin(tiltRad) + z * math.cos(tiltRad)
                
                local finalPosition = basePosition + Vector3.new(x_tilted, y_tilted, z_tilted)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "sphere" then
                -- 球体モード：完全な球体に配置
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- フィボナッチ球体配置（均等に分散）
                local phi = math.pi * (3 - math.sqrt(5))  -- 黄金角
                local y = 1 - (index / (totalObjects - 1)) * 2  -- -1から1まで
                local radiusAtY = math.sqrt(1 - y * y)
                
                local theta = phi * index + (time * rowConfig.sphereRotationSpeed)
                
                local x = math.cos(theta) * radiusAtY * rowConfig.sphereRadius
                local z = math.sin(theta) * radiusAtY * rowConfig.sphereRadius
                local yPos = y * rowConfig.sphereRadius
                
                local finalPosition = basePosition + Vector3.new(x, yPos, z)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "heart" then
                -- ハートモード：ハート型に配置
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 全体の回転
                local globalRotation = time * rowConfig.heartRotationSpeed
                
                -- ハート型の parametric equation
                -- x = 16*sin(t)^3
                -- y = 13*cos(t) - 5*cos(2t) - 2*cos(3t) - cos(4t)
                local t = (index / totalObjects) * 2 * math.pi + globalRotation
                
                local x = 16 * math.pow(math.sin(t), 3) * (rowConfig.heartSize / 20)
                local y = (13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t)) * (rowConfig.heartSize / 20)
                local z = 0
                
                -- ハートの傾きを適用
                local tiltRad = math.rad(rowConfig.heartTilt)
                local x_tilted = x
                local y_tilted = y * math.cos(tiltRad) - z * math.sin(tiltRad)
                local z_tilted = y * math.sin(tiltRad) + z * math.cos(tiltRad)
                
                local finalPosition = basePosition + Vector3.new(x_tilted, y_tilted, z_tilted)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            elseif rowConfig.animationMode == "pentagram" then
                -- 五芒星モード：5つの頂点を結ぶ星型
                local totalObjects = #rowPoints
                local index = obj.index - 1
                
                -- 全体の回転
                local globalRotation = time * rowConfig.pentagramRotationSpeed
                
                -- 五芒星の5つの頂点（円周上の点）
                local vertices = {}
                for i = 0, 4 do
                    local angle = (i * 2 * math.pi / 5) - (math.pi / 2) + globalRotation
                    vertices[i] = {
                        x = math.cos(angle) * rowConfig.pentagramRadius,
                        z = math.sin(angle) * rowConfig.pentagramRadius
                    }
                end
                
                -- 星型を描く順序: 0→2→4→1→3→0
                local starPath = {
                    {from = 0, to = 2},
                    {from = 2, to = 4},
                    {from = 4, to = 1},
                    {from = 1, to = 3},
                    {from = 3, to = 0}
                }
                
                -- 各辺に配置するオブジェクト数
                local objectsPerEdge = totalObjects / 5
                
                -- どの辺上にいるか
                local edgeIndex = math.floor(index / objectsPerEdge) % 5
                local t = (index % objectsPerEdge) / objectsPerEdge
                
                -- 現在の辺の開始点と終了点
                local edge = starPath[edgeIndex + 1]
                local startVertex = vertices[edge.from]
                local endVertex = vertices[edge.to]
                
                -- 線形補間で位置を計算
                local x = startVertex.x + (endVertex.x - startVertex.x) * t
                local z = startVertex.z + (endVertex.z - startVertex.z) * t
                local y = 0
                
                -- 五芒星の傾きを適用
                local tiltRad = math.rad(rowConfig.pentagramTilt)
                local x_tilted = x
                local y_tilted = y * math.cos(tiltRad) - z * math.sin(tiltRad)
                local z_tilted = y * math.sin(tiltRad) + z * math.cos(tiltRad)
                
                local finalPosition = basePosition + Vector3.new(x_tilted, y_tilted, z_tilted)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            else
                -- 波モード（既存の動き）
                local distanceFromCenter = math.abs(obj.baseOffsetX)
                local amplitude = rowConfig.baseAmplitude + (distanceFromCenter * rowConfig.distanceMultiplier)
                
                local phase = time + (obj.index * rowConfig.phaseOffset)
                local waveValue = math.sin(phase)
                local waveMovement = waveValue * amplitude
                
                local horizontalOffset = obj.baseOffsetX
                if obj.baseOffsetX ~= 0 then
                    local horizontalShrink = waveValue * rowConfig.horizontalWaveAmount
                    local sign = obj.baseOffsetX > 0 and 1 or -1
                    horizontalOffset = obj.baseOffsetX - (sign * math.abs(obj.baseOffsetX) * horizontalShrink)
                end
                
                local targetPosition = basePosition + (rightVector * horizontalOffset)
                local finalPosition = targetPosition + Vector3.new(0, waveMovement, 0)
                
                if point.part then
                    point.part.Position = finalPosition
                end
                
                obj.BP.Position = finalPosition
                
                local baseCFrame = CFrame.new(finalPosition)
                local _, playerYRot, _ = charCFrame:ToOrientation()
                baseCFrame = baseCFrame * CFrame.Angles(0, playerYRot + math.rad(rowConfig.yRotation), 0)
                baseCFrame = baseCFrame * CFrame.Angles(math.rad(rowConfig.xRotation), 0, 0)
                baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(rowConfig.zRotation))
                
                local currentCFrame = obj.BG.CFrame
                local interpolatedCFrame = currentCFrame:Lerp(baseCFrame, rowConfig.smoothness)
                
                obj.BG.CFrame = interpolatedCFrame
            end
        end
    end
end)

